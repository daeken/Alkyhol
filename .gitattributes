# Preserve the pinned Microsoft shader's original CRLF bytes on every host.
shader/tests/fixtures/microsoft-hello-triangle.hlsl -text whitespace=cr-at-eol
shader/samples/**/original/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
shader/samples/sakura/*.generated.hlsli -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
shader/samples/miniengine/*.generated.hlsli -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

cpp/licenses/* -text whitespace=cr-at-eol
cpp/bridge/*.patch whitespace=-blank-at-eol

# Shared C++ probes must have identical actual bytes on native Windows and macOS.
cpp/tests/* text eol=lf
cpp/reference/probes/* text eol=lf

# This generator is part of the cross-host CBV fixture identity.
tools/build_cpp_cbv_probe.py text eol=lf

# Exact shared compute fixture bytes and generator identity on every host.
cpp/tests/compute_probe.dxil -text
tools/build_cpp_compute_probe.py text eol=lf
shader/tests/fixtures/compute.hlsl text eol=lf

# One PE fixture is built on macOS and executed unchanged on Windows.
pe/fixtures/* text eol=lf
